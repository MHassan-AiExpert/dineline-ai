{
  "name": "DineLine 05 \u00b7 Reservation Reminders",
  "nodes": [
    {
      "parameters": {
        "content": "## 05 \u00b7 Reservation reminders\nEvery 15 minutes: asks DineLine which bookings start within 2 hours and haven't been reminded, texts each guest, then marks them as sent.\n\nSet Config and the Twilio credential, then activate.",
        "height": 260,
        "width": 380
      },
      "id": "72585a77-49d1-494a-8c8c-bb4518264083",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        20
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "93f3726f-f16c-4dc7-b5eb-faa6809f3496",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "04c11861-3e77-48f4-893e-b3ca8c3a4fd1",
              "name": "appUrl",
              "value": "https://YOUR-APP-URL",
              "type": "string"
            },
            {
              "id": "264656c5-f99a-4ca7-b57f-742830cba32b",
              "name": "secret",
              "value": "",
              "type": "string"
            },
            {
              "id": "ee6d6190-0d8b-4119-8c68-4c3f1b8b38c2",
              "name": "twilioFrom",
              "value": "+1XXXXXXXXXX",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "c9d48f5e-5f81-4f35-a3ed-ca864cff6be1",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "Set your app URL (ngrok or Vercel) and the DINELINE_WEBHOOK_SECRET value here."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.appUrl }}/api/reservations/reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-dineline-secret",
              "value": "={{ $('Config').first().json.secret }}"
            }
          ]
        },
        "options": {}
      },
      "id": "5fe5d9ec-a904-4ee5-be59-c8262b418fb3",
      "name": "Get due reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return ($json.reminders ?? []).map(r => ({ json: r }));"
      },
      "id": "d24e784c-21ed-45b1-8ebd-65ec54dd3436",
      "name": "One item per guest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "from": "={{ $('Config').first().json.twilioFrom }}",
        "to": "={{ $json.to }}",
        "toWhatsapp": false,
        "message": "={{ $json.body }}",
        "options": {}
      },
      "id": "12ad6fa6-865c-4074-8171-a4c35cccf8bb",
      "name": "Text the guest",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        880,
        300
      ],
      "notes": "Choose your Twilio credential (Account SID + Auth Token). For WhatsApp, use the sandbox number as twilioFrom in Config."
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ids: $('One item per guest').all().map(i => i.json.id) } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "be86b3de-8f27-46a5-9adb-5aacf3a49b41",
      "name": "Collect ids",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.appUrl }}/api/reservations/reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-dineline-secret",
              "value": "={{ $('Config').first().json.secret }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ids: $json.ids }) }}"
      },
      "id": "f2f582ab-46c4-49e1-b38d-28b272aa237d",
      "name": "Mark reminders sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ]
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
