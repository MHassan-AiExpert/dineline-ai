            "index": 0
          }
        ]
      ]
    },
    "One item per guest": {
      "main": [
        [
          {
            "node": "Text the guest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Text the guest": {
      "main": [
        [
          {
            "node": "Collect ids",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect ids": {
      "main": [
        [
          {
            "node": "Mark reminders sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
