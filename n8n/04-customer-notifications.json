            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "f9d91c08-8446-41c0-83bd-01004ea06b02",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "Set your app URL (ngrok or Vercel) and the DINELINE_WEBHOOK_SECRET value here."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "65a97702-c7e9-4010-979f-afbc43d2168c",
              "leftValue": "={{ !$('Config').first().json.secret || ($('From DineLine app').first().json.headers['x-dineline-secret'] ?? $('From DineLine app').first().json.headers['x-vapi-secret']) === $('Config').first().json.secret }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1315b839-b49d-491b-a8c2-5ad1aa5010fa",
      "name": "Secret OK?",
