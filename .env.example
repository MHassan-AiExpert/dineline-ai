# ─────────────────────────────────────────────────────────────
# DineLine AI configuration
# Copy this file to .env.local and fill in what you have.
# Everything is optional: with no keys the app runs in demo mode
# (built-in rule-based crew + local data store).
# ─────────────────────────────────────────────────────────────

# Public URL of this app (used by Vapi tools and n8n). Use your ngrok /
# Cloudflare tunnel URL locally, or your Vercel URL in production.
PUBLIC_APP_URL=http://localhost:3000

# Shared secret that Vapi and n8n send in the x-dineline-secret header.
# Leave empty to accept requests without a secret (local testing only).
DINELINE_WEBHOOK_SECRET=

# ── LLM for the agent crew (OpenAI-compatible API) ───────────
# Provider: gemini | openai | groq | openrouter
LLM_PROVIDER=gemini
LLM_API_KEY=
# Examples: gemini-2.5-flash | gpt-4o-mini | llama-3.3-70b-versatile
LLM_MODEL=gemini-2.5-flash
# Optional: any other OpenAI-compatible endpoint
LLM_BASE_URL=

# ── Supabase (optional; local JSON store is used when empty) ─
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Vapi ─────────────────────────────────────────────────────
VAPI_PRIVATE_KEY=
# Optional: attach the squad to this Vapi phone number on `npm run setup:vapi`
VAPI_PHONE_NUMBER_ID=
# Optional: real staff number (E.164) for live transfers
TRANSFER_PHONE_NUMBER=
# Optional: voice model settings for the phone agents
VAPI_MODEL=gpt-4o-mini
VAPI_VOICE_ID=Elliot
# Optional: send tool calls / call events through n8n workflows 01–03 and 06
VAPI_TOOLS_URL_LOOKUP=
VAPI_TOOLS_URL_ORDERS=
VAPI_TOOLS_URL_RESERVATIONS=
VAPI_EVENTS_URL=
# Browser "Talk to the crew" button
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_SQUAD_ID=

# ── Notifications ────────────────────────────────────────────
# Option A: send events to n8n workflow 04 (recommended)
N8N_NOTIFY_WEBHOOK_URL=
# Option B: send SMS straight from the app via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Set to "whatsapp" to send through the Twilio WhatsApp sandbox
TWILIO_CHANNEL=sms
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
